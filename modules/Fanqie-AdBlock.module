#!name=番茄综合拦截（禁音视频·候选）
#!desc=2026-09-18.2；综合已知广告路径并拦截番茄音视频。旧版实机无效，新版待验收；听书路径为候选，不保证完整覆盖。启用前停用旧番茄模块。需要可信HTTPS解密。
#!author=q85985477
#!url=https://raw.githubusercontent.com/q85985477/shadowrocket-modules/main/modules/Fanqie-AdBlock.module
#!homepage=https://github.com/q85985477/shadowrocket-modules/blob/main/modules/Fanqie-AdBlock.module

# 设计范围：广告与番茄音视频拦截，不配置DIRECT/PROXY、DNS或TUN路由。
# 依据：zqzess/FanQieNovel.sgmodule、deezertidal/fanqie.module 的公开广告接口线索。
# 综合参考 zqzess 与 honue，去掉历史IP和全字节域名封锁；不是会员解锁。
# https://github.com/honue/rules/blob/master/Loon/plugin/FanQieNovel.plugin
# 视频CDN整域拒绝；听书audio/tts路径是待实机验证的候选，非抓包确认。
# 本模块不是App进程隔离：共用以下广告接口的其他App也会命中。
# 地区模块等其他模块若使用 hostname = 而不是 hostname = %APPEND%，可能覆盖此名单。

[Rule]
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
# 用户要求禁用番茄视频，包含正常视频内容
DOMAIN-SUFFIX,fqnovelvod.com,REJECT

[URL Rewrite]
^https?:\/\/[A-Za-z0-9.-]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(?:get_ads|stats|settings)(?:\/|\?|$) - reject
^https?:\/\/[A-Za-z0-9.-]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/(?:ad-app-package|ad)\/ - reject
^https?:\/\/[A-Za-z0-9.-]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/web\.business\.image\/ - reject
^https?:\/\/[A-Za-z0-9.-]+\.(?:pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer(?:\/|\?|$) - reject
^https?:\/\/[A-Za-z0-9.-]+\.(?:pglstatp-toutiao|pstatp)\.com\/obj\/ad-site-adstyle-public\/ - reject
^https?:\/\/[A-Za-z0-9.-]+\.byteimg\.com\/(?:ad-app-package|web\.business\.image)\/ - reject

# 原作者补充路径与用户要求的媒体拦截
^https?:\/\/[A-Za-z0-9.-]+\.snssdk\.com\/api\/ad\/ - reject
^https?:\/\/[A-Za-z0-9.-]+\.snssdk\.com\/video\/play\/1\/toutiao\/ - reject
^https?:\/\/[A-Za-z0-9.-]+\.pstatp\.com\/obj\/mosaic-legacy\/[^?]*\?(?:[^#]*&)?from=ad(?:&|$) - reject
^https?:\/\/[A-Za-z0-9.-]+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/ - reject
^https?:\/\/[A-Za-z0-9.-]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:ad-app-package|ad)\/ - reject
^https?:\/\/[A-Za-z0-9-]*ad-sign[A-Za-z0-9-]*\.byteimg\.com\/ - reject
^https?:\/\/adim\.pinduoduo\.com\/[^?]+\/toutiao\? - reject
^https?:\/\/[A-Za-z0-9-]+-novelapp\.ixigua\.com\/ - reject
^https?:\/\/(?:[A-Za-z0-9-]+\.)*(?:fqnovel|fanqienovel|changdunovel)\.com\/(?:[^/?]+\/)*(?:audio|tts|video)(?:\/|\?|$) - reject

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.com,*.pglstatp-toutiao.com,*.pstatp.com,*.byteimg.com,*.snssdk.com,adim.pinduoduo.com,*-novelapp.ixigua.com,fqnovel.com,*.fqnovel.com,fanqienovel.com,*.fanqienovel.com,changdunovel.com,*.changdunovel.com

# HTTPS解密按主机名生效：上面共享CDN域名的普通请求也会被解密，但不会被本模块全部拒绝。
# 不携带证书/密钥；不修改全局解密开关；不加入内网、远程桌面、支付或AI服务域名。
